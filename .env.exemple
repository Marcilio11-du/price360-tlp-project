DB_HOST=localhost
DB_USER=user
DB_PASS=senha
DB_NAME=price360_db
DB_PORT=3306
PORT=3000
JWT_SECRET=troque_este_valor_por_um_seguro
ENABLE_SCRAPERS=true

SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Xé Preço <alertas@xepreco.ao>"

# ─── Autenticação social (OAuth 2.0) ──────────────────────────
# Google: https://console.cloud.google.com → Credenciais → ID do cliente OAuth
#   Redirect URI autorizado: {API_URL}/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple: https://developer.apple.com → Identifiers → Services ID
#   Return URL: {API_URL}/api/v1/auth/oauth/apple/callback
# APPLE_PRIVATE_KEY = conteúdo da chave .p8 com \n nos saltos de linha
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# URL da API (para os redirect_uri) e do frontend (retorno com JWT)
API_URL=http://localhost:3000
